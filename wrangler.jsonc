{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-base-staging",
  "account_id": "678720af4dded7d23aad4a859b6e5f3a",
  "main": "worker.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "COMMERCE_DB",
      "database_name": "the-base-commerce-staging",
      "database_id": "2f72ccbc-95ae-43f7-9622-5341892d9306",
      "migrations_dir": "migrations/commerce"
    }
  ],
  "env": {
    "staging": {
      "name": "the-base-staging",
      "workers_dev": true,
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "COMMERCE_DB",
          "database_name": "the-base-commerce-staging",
          "database_id": "2f72ccbc-95ae-43f7-9622-5341892d9306",
          "migrations_dir": "migrations/commerce"
        }
      ],
      "vars": {
        "APP_ENV": "staging"
      }
    },
    "production": {
      "name": "the-base-production",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "APP_ENV": "production"
      }
    }
  }
}
