{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-base-staging",
  "account_id": "678720af4dded7d23aad4a859b6e5f3a",
  "main": "worker.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "the-base-staging",
      "workers_dev": true,
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "SHOP_ORDERS",
          "database_name": "the-base-staging-orders",
          "database_id": "24bce93e-5b5b-4f0d-b78f-4806822a9e8d",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_ENV": "staging"
      }
    },
    "production": {
      "name": "the-base-production",
      "workers_dev": true,
      "preview_urls": true,
      "d1_databases": [
        {
          "binding": "SHOP_ORDERS",
          "database_name": "the-base-live-orders",
          "database_id": "359415ea-a600-4a7c-b02a-83b7ee2b454f",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_ENV": "production"
      }
    }
  }
}
