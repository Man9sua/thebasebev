# Existing public analytics containers. Keep these values aligned with the
# production properties; do not create replacement properties for migration.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Upstream lead endpoint. Server-side only — /api/leads is the sole reader, and
# a NEXT_PUBLIC_ prefix here would leak the Odoo pipeline into the browser.
# Set the real value in the local .env / Cloudflare environment, never in Git.
# Current value for staging and production: the existing tilda-odoo Worker.
LEAD_API_URL=

# Optional. The tilda-odoo Worker accepts unauthenticated posts today, so this
# stays empty until an authenticated upstream replaces it.
LEAD_API_KEY=

# Direct commerce integration. Server-side only. Enable only with a dedicated
# least-privilege write credential and a fully verified 13-product mapping.
ODOO_URL=
ODOO_DATABASE=
ODOO_LOGIN=
ODOO_API_KEY=
ODOO_COMMERCE_ENABLED=
ODOO_PRODUCT_MAPPING_JSON=
ODOO_SHIPPING_PRODUCT_ID=
ODOO_SHIPPING_DEFAULT_CODE=

# Isolated Stripe Test Mode proof of concept. Never commit actual values and
# never place the secret or webhook secret behind a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Explicit commerce policy. Shipping, tax, discounts, and inventory remain
# disabled until the business supplies authoritative rules.
COMMERCE_SHIPPING_ENABLED=
COMMERCE_SHIPPING_FIXED_RATE_AED=
COMMERCE_FREE_SHIPPING_THRESHOLD_AED=
COMMERCE_SHIPPING_LABEL=
COMMERCE_STRIPE_AUTOMATIC_TAX_ENABLED=
COMMERCE_PROMOTION_CODES_ENABLED=
COMMERCE_INVENTORY_ENFORCEMENT=

# Optional Telegram notification fan-out. Not configured until the business
# confirms the destination and supplies Test/Staging credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
