# Existing public analytics containers. Keep these values aligned with the
# production properties; do not create replacement properties for migration.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Upstream lead endpoint. Server-side only — /api/leads is the sole reader, and
# a NEXT_PUBLIC_ prefix here would leak the Odoo pipeline into the browser.
# Set the real value in the local .env / Cloudflare environment, never in Git.
# Current value for staging and production: the existing tilda-odoo Worker.
LEAD_API_URL=

# Optional. The tilda-odoo Worker accepts unauthenticated posts today, so this
# stays empty until an authenticated upstream replaces it.
LEAD_API_KEY=

# Server-side paid-order receiver. This is separate from the lead relay.
ODOO_URL=
ODOO_API_KEY=
ODOO_DATABASE=

# Staging Test Mode shop checkout. Never commit actual values and
# never place the secret or webhook secret behind a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_UAE_VAT_RATE_ID=
# Set to test only after the staging ledger and Odoo receiver are configured.
SHOP_PAYMENTS_ENABLED=

# Separate Live configuration for the approved production-preview Worker.
# The restricted key is preferred at runtime. Keep the full secret key local
# for provisioning; do not upload it when the restricted key is configured.
STRIPE_LIVE_SECRET_KEY=
STRIPE_LIVE_RESTRICTED_KEY=
STRIPE_LIVE_ACCOUNT_ID=
STRIPE_LIVE_WEBHOOK_SECRET=
STRIPE_LIVE_UAE_VAT_RATE_ID=
ODOO_LIVE_ACTION_ID=
SHOP_LIVE_ORIGIN=
# Only the approved Live Worker receives SHOP_PAYMENTS_ENABLED=live and
# APP_ENV=production. Staging keeps test and its own SHOP_ORDERS database.

# Optional Telegram notification fan-out. Not configured until the business
# confirms the destination and supplies Test/Staging credentials.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MESSAGE_THREAD_ID=
