# Existing public analytics containers. Keep these values aligned with the
# production properties; do not create replacement properties for migration.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Owned lead-delivery endpoint. LEAD_API_KEY is read only by /api/leads and
# must never use a NEXT_PUBLIC_ prefix.
LEAD_API_URL=
LEAD_API_KEY=

# Reserved for a future adapter behind the same typed lead layer.
ODOO_URL=
ODOO_API_KEY=
